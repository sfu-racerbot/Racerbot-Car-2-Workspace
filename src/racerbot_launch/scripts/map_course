#!/usr/bin/env python3
"""Map a course in one command, then print how to race it.

    ros2 run racerbot_launch map_course                       # 3 laps
    ros2 run racerbot_launch map_course mapping_max_speed:=1.5 # new course

bringup_launch.py must already be running in another terminal (the
simulator's sim_bringup_launch.py also counts). map_course never starts the
hardware drivers itself, and refuses to start without them.

Runs ``ros2 launch racerbot_launch map_course_launch.py`` with any
``name:=value`` arguments passed through, waits for it to finish (it stops
itself after the laps; Ctrl+C also works), then prints the run directory's
commands.txt -- the copy-paste race commands -- as the last thing on screen,
after every node's shutdown messages.

Everything the launch prints is also saved to
~/.ros/racerbot_runs/map_course-<timestamp>.log, lap progress included.

Hold LB the whole time the car should move. See docs/launchstart.md.
"""

import os
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_OUTPUT = '~/.ros/racerbot_auto'
# What has to be running before map_course will start: the car's drivers
# from bringup_launch.py (VESC and LiDAR), or the simulator's bridge.
REAL_DRIVERS = ('vesc_driver_node', 'urg_node_driver')
SIM_DRIVER = 'gym_bridge_node'


def _running(pattern) -> bool:
    return subprocess.run(['pgrep', '-f', pattern], capture_output=True).returncode == 0


def output_directory(argv):
    """The output_directory:= argument if given, else the launch default."""
    for arg in argv:
        if arg.startswith('output_directory:='):
            return Path(os.path.expanduser(arg.split(':=', 1)[1]))
    return Path(os.path.expanduser(DEFAULT_OUTPUT))


def missing_drivers():
    """[] when the hardware layer is up, else the driver processes missing."""
    if _running(SIM_DRIVER):
        return []
    return [name for name in REAL_DRIVERS if not _running(name)]


def new_run(parent: Path, since: float):
    """The newest run directory under ``parent`` with a commands.txt written
    at or after ``since`` (epoch seconds), or None."""
    if not parent.is_dir():
        return None
    best = None
    for child in parent.iterdir():
        commands = child / 'commands.txt'
        try:
            mtime = commands.stat().st_mtime
        except OSError:
            continue
        if child.is_dir() and mtime >= since and (best is None or mtime > best[0]):
            best = (mtime, child)
    return None if best is None else best[1]


LOG_DIRECTORY = '~/.ros/racerbot_runs'


def log_path(now=None) -> Path:
    stamp = time.strftime('%Y%m%d-%H%M%S', time.localtime(now))
    return Path(os.path.expanduser(LOG_DIRECTORY)) / f'map_course-{stamp}.log'


def report(parent: Path, since: float) -> str:
    run = new_run(parent, since)
    if run is None:
        return (
            '\nNo map was saved by this run: it ended before the laps were '
            'done (Ctrl+C, LB released for good, or an error above).\n'
            f'Earlier runs, if any, are in {parent}/ -- each has a commands.txt.\n')
    return '\n' + (run / 'commands.txt').read_text()


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    bad = [a for a in argv if ':=' not in a]
    if bad:
        print(f'map_course: arguments must look like name:=value, got {bad}', file=sys.stderr)
        return 2
    missing = missing_drivers()
    if missing:
        print('map_course: the hardware is not running (no ' + ', '.join(missing) +
              '). Start it first, in its own terminal, and leave it running:\n'
              '    ros2 launch f1tenth_stack bringup_launch.py\n'
              'then run map_course again.', file=sys.stderr)
        return 2
    started = time.time() - 1.0
    log = log_path()
    log.parent.mkdir(parents=True, exist_ok=True)
    with open(log, 'w', errors='replace') as handle:
        child = subprocess.Popen(
            ['ros2', 'launch', 'racerbot_launch', 'map_course_launch.py', *argv],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
            errors='replace', bufsize=1)
        while True:
            try:
                for line in child.stdout:
                    sys.stdout.write(line)
                    handle.write(line)
                code = child.wait()
                break
            except KeyboardInterrupt:
                # The terminal already sent SIGINT to ros2 launch too; keep
                # copying its shutdown output, then report.
                continue
        text = report(output_directory(argv), started)
        handle.write(text)
    print(text)
    print(f'Full log of this run: {log}')
    return code


if __name__ == '__main__':
    sys.exit(main())
