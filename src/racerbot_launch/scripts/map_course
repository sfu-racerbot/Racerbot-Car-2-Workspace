#!/usr/bin/env python3
"""Map a course in one command, then print how to race it.

    ros2 run racerbot_launch map_course                       # 3 laps
    ros2 run racerbot_launch map_course mapping_max_speed:=1.5 # new course
    ros2 run racerbot_launch map_course include_bringup:=false

Runs ``ros2 launch racerbot_launch map_course_launch.py`` with any
``name:=value`` arguments passed through, waits for it to finish (it stops
itself after the laps; Ctrl+C also works), then prints the run directory's
commands.txt -- the copy-paste race commands -- as the last thing on screen,
after every node's shutdown messages.

Hold LB the whole time the car should move. See docs/launchstart.md.
"""

import os
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_OUTPUT = '~/.ros/racerbot_auto'
# Hardware drivers bringup_launch.py starts. Only one copy of each may run:
# two vesc_driver_nodes on one serial port read each other's bytes (the log
# fills with "Out-of-sync with VESC"), and the Hokuyo takes one connection
# ("could not open ethernet port").
DRIVER_PATTERNS = ('vesc_driver_node', 'urg_node_driver')


def output_directory(argv):
    """The output_directory:= argument if given, else the launch default."""
    for arg in argv:
        if arg.startswith('output_directory:='):
            return Path(os.path.expanduser(arg.split(':=', 1)[1]))
    return Path(os.path.expanduser(DEFAULT_OUTPUT))


def drivers_running() -> bool:
    """Whether the car's hardware drivers are already up (a bringup_launch.py
    in another terminal)."""
    for pattern in DRIVER_PATTERNS:
        found = subprocess.run(['pgrep', '-f', pattern], capture_output=True)
        if found.returncode == 0:
            return True
    return False


def with_bringup_choice(argv, running: bool):
    """``argv`` plus ``include_bringup:=false`` when the drivers are already
    running and the caller did not choose. An explicit choice is kept."""
    if running and not any(a.startswith('include_bringup:=') for a in argv):
        return list(argv) + ['include_bringup:=false']
    return list(argv)


def new_run(parent: Path, since: float):
    """The newest run directory under ``parent`` with a commands.txt written
    at or after ``since`` (epoch seconds), or None."""
    if not parent.is_dir():
        return None
    best = None
    for child in parent.iterdir():
        commands = child / 'commands.txt'
        try:
            mtime = commands.stat().st_mtime
        except OSError:
            continue
        if child.is_dir() and mtime >= since and (best is None or mtime > best[0]):
            best = (mtime, child)
    return None if best is None else best[1]


def report(parent: Path, since: float) -> str:
    run = new_run(parent, since)
    if run is None:
        return (
            '\nNo map was saved by this run: it ended before the laps were '
            'done (Ctrl+C, LB released for good, or an error above).\n'
            f'Earlier runs, if any, are in {parent}/ -- each has a commands.txt.\n')
    return '\n' + (run / 'commands.txt').read_text()


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    bad = [a for a in argv if ':=' not in a]
    if bad:
        print(f'map_course: arguments must look like name:=value, got {bad}', file=sys.stderr)
        return 2
    running = drivers_running()
    launch_args = with_bringup_choice(argv, running)
    if running and launch_args != argv:
        print('map_course: the car\'s drivers are already running (bringup_launch.py '
              'in another terminal), so using those instead of starting a second '
              'copy (include_bringup:=false).', flush=True)
    elif running:
        print('map_course: WARNING: the car\'s drivers are already running and '
              'include_bringup was set explicitly; a second copy will fight the '
              'first for the VESC and the LiDAR.', flush=True)
    started = time.time() - 1.0
    child = subprocess.Popen(
        ['ros2', 'launch', 'racerbot_launch', 'map_course_launch.py', *launch_args])
    while True:
        try:
            code = child.wait()
            break
        except KeyboardInterrupt:
            # The terminal already sent SIGINT to ros2 launch too; let it
            # finish shutting the nodes down, then report.
            continue
    print(report(output_directory(argv), started))
    return code


if __name__ == '__main__':
    sys.exit(main())
