<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>racerbot_sim</name>
  <version>0.1.0</version>
  <description>Headless F1TENTH Gym simulator exposed as ROS2 topics, so the real driving stack (gap_follow, pure_pursuit, auto_map_race_node, slam_toolbox, web_dashboard) can be run and validated end to end without the car</description>
  <maintainer email="bryanmaubc@gmail.com">racerbotcar-2</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>ackermann_mux</exec_depend>
  <exec_depend>gap_follow</exec_depend>
  <exec_depend>pure_pursuit</exec_depend>
  <exec_depend>racerbot_launch</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
