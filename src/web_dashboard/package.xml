<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>web_dashboard</name>
  <version>0.1.0</version>
  <description>Read-only live browser dashboard for map, proximity-colored LIDAR, pose, vehicle telemetry, LB-gated stopwatch, system health, and camera recording view.</description>
  <maintainer email="bryanmaubc@gmail.com">racerbotcar-2</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>std_msgs</depend>
  <depend>drive_intent</depend>
  <depend>ament_index_python</depend>
  <depend>python3-tornado</depend>
  <depend>python3-psutil</depend>
  <!-- diffing occupancy grids for map patches, see mapstream.py -->
  <depend>python3-numpy</depend>
  <!-- The Reset service for the dashboard's live-SLAM reset. exec_depend,
       not depend: this package's tests deliberately run with no ROS
       sourced, and the import is guarded so a machine without
       slam_toolbox still gets a working dashboard. -->
  <exec_depend>slam_toolbox</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
